rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Products: authenticated read only. Writes via Admin SDK only.
    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Bag categories: authenticated read only.
    match /bagCategories/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Store config (e.g. shippingAreasCost): authenticated read only.
    match /storeConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Customers: each user owns only their document and sub-collections.
    match /customers/{customerId} {
      allow read, write: if request.auth != null && request.auth.uid == customerId;

      match /{subCollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == customerId;
      }
    }

    // Orders: users can read and create their own orders only. No updates or deletes from client.
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.customerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if false;
    }

    // Audit logs: server-only (Admin SDK bypasses rules). Explicit for clarity.
    match /auditLogs/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
